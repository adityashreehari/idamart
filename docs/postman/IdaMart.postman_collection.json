              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"One line in cart\", () => pm.expect(pm.response.json().items.length).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change quantity to 2",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
