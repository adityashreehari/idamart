            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().content.find(x => x.inStock);",
                  "if (p) pm.collectionVariables.set(\"productId\", p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by keyword",
          "request": {
