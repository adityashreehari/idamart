    {
      "name": "4. Cart (customer)",
      "item": [
        {
          "name": "Empty the cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
